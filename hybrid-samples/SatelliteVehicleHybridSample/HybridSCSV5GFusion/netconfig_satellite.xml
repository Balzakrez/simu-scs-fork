<!-- netconfig_satellite.xml -->
<config>
    <!-- 1. Configura le interfacce dei VEICOLI su wlan0 (Service Link) -->
    <interface hosts='node[*]' names='wlan0' address='10.1.0.x' netmask='255.255.255.0'/>
    
    <!-- 2. Configura l'interfaccia del SATELLITE verso i veicoli (cnl1) -->
    <!-- Assicurati che cnl1 sia quella a 10.825GHz definita nell'INI -->
    <interface hosts='satellite[*]' names='cnl1' address='10.1.0.1' netmask='255.255.255.0'/>
    
    <!-- 3. Configura il resto (Backhaul/Feeder link verso MCC) su un'altra subnet -->
    <interface hosts='**' address='10.2.x.x' netmask='255.255.x.x'/>

    <!-- 4. Metrica Fondamentale: Senza questa, il C++ moddato non viene chiamato per il ritardo -->
    <autoroute metric='propagationDelay'/>
</config>